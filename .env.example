# Required on the server (Vercel -> Project -> Settings -> Environment Variables).
# The browser never sees this key; only the /api functions read it.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Which model writes the questions, and which one checks them.
# Defaults to claude-sonnet-5 for both. Set either to claude-opus-5 for higher
# quality at roughly 2.5x the cost.
# QUIZ_MODEL=claude-sonnet-5
# QUIZ_VERIFY_MODEL=claude-sonnet-5

# Optional, local development only. Set to "true" to skip the API entirely and
# play with placeholder questions.
# VITE_USE_MOCK_QUESTIONS=true
